+  width: 100%;
+  table-layout: fixed;
+  border-collapse: collapse;
+}
+.field-enum-list th,
+.field-enum-list td {
+  padding: 5px 7px;
+  border-bottom: 1px solid #e2e8f0;
+  vertical-align: middle;
+  overflow-wrap: anywhere;
+}
+.field-enum-list th {
+  text-align: left;
+  font-size: 11px;
+  background: #f1f5f9;
+}
+.field-enum-list th:first-child {
+  width: 50%;
+}
+.field-enum-list th:last-child {
+  width: 48px;
+}
+.field-enum-list tr:last-child td {
+  border-bottom: 0;
+}
+.field-enum-list code {
+  font-size: 11px;
+}
+.field-enum-list button {
+  color: #b45309;
+  font-size: 11px;
+  white-space: nowrap;
+}
+.field-enum-default {
+  margin-left: 5px;
+  color: #0f766e;
+  font-size: 10px;
+}
+.field-enum-empty {
+  padding: 8px;
+  background: #f8fafc;
+  border-radius: 6px;
+  color: #64748b;
+}
+.field-enum-add {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
+  gap: 6px;
+  margin-top: 8px;
+}
+.field-enum-add input {
+  width: 100%;
+  min-width: 0;
+  padding: 5px 7px;
+  border: 1px solid #cbd5e1;
+  border-radius: 5px;
+  background: transparent;
+  color: inherit;
+}
+.field-enum-add button {
+  padding: 5px 10px;
+  border-radius: 5px;
+  background: #0f766e;
+  color: white;
+}
+.field-enum-hint {
+  font-size: 10px;
+  color: #64748b;
+  line-height: 1.5;
+  margin-top: 6px;
+  overflow-wrap: anywhere;
+}
+.field-enum-error {
+  color: #b91c1c;
+  margin-top: 5px;
+}
+.field-enum-warning {
+  color: #b45309;
+  font-size: 11px;
+  margin-top: 5px;
+}
+[theme-mode="dark"] .field-enum-editor {
+  color: #e2e8f0;
+  border-color: #475569;
+}
+[theme-mode="dark"] .field-enum-list,
+[theme-mode="dark"] .field-enum-list td,
+[theme-mode="dark"] .field-enum-add input {
+  border-color: #475569;
+}
+[theme-mode="dark"] .field-enum-list th,
+[theme-mode="dark"] .field-enum-empty {
+  background: #263244;
+  color: #cbd5e1;
+}
+.field-enum-config .field-enum-editor {
+  width: 100%;
+  max-width: 100%;
+}
+.field-enum-config .field-enum-add {
+  grid-template-columns: minmax(0, 1fr) auto;
