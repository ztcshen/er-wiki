+.field-enum-editor {
+  width: 360px;
+  max-width: calc(100vw - 56px);
+  margin-top: 12px;
+  border-top: 1px solid #dbe3ec;
+  padding-top: 10px;
+  color: #334155;
+  font-size: 12px;
+}
