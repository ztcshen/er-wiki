diff --git a/src/components/EditorHeader/ReviewToolbar.jsx b/src/components/EditorHeader/ReviewToolbar.jsx
new file mode 100644
index 0000000..d5e5e08
--- /dev/null
+++ b/src/components/EditorHeader/ReviewToolbar.jsx
@@ -0,0 +1,50 @@
+import {useDiagram,useLayout,useSettings,useSelect} from '../../hooks';
+import {ObjectType} from '../../data/constants';
+import './review-toolbar.css';
+import GroupControls from './GroupControls';
+import useGroupView from '../../hooks/useGroupView';
+import { edgeStyle } from '../../utils/edgePresentation';
+import useRelationshipFocus from '../../hooks/useRelationshipFocus';
+
+export default function ReviewToolbar({arrange,fit,undo,canUndo,save}){
+  const {tables,relationships}=useDiagram();
+  const {layout,setLayout}=useLayout();
+  const {settings,setSettings}=useSettings();
+  const {selectedElement,setSelectedElement}=useSelect();
+  const focus=useRelationshipFocus();
+  const groupScope=useGroupView();
+  const hoveredTable=focus.hover?.tableId!==undefined?tables.find(t=>t.id===focus.hover.tableId):null;
+  const hoveredField=hoveredTable?.fields.find(f=>f.id===focus.hover.fieldId);
+  const selected=tables.find(t=>selectedElement.element===ObjectType.TABLE&&t.id===selectedElement.id);
+  const selectedEdge=relationships.find(r=>selectedElement.element===ObjectType.RELATIONSHIP&&r.id===selectedElement.id);
+  const source=selectedEdge&&tables.find(t=>t.id===selectedEdge.startTableId);
+  const target=selectedEdge&&tables.find(t=>t.id===selectedEdge.endTableId);
+  const edgeText=selectedEdge?`${source?.name}.${source?.fields.find(f=>f.id===selectedEdge.startFieldId)?.name} → ${target?.name}.${target?.fields.find(f=>f.id===selectedEdge.endFieldId)?.name}`:'';
+  const count=selected?relationships.filter(r=>r.startTableId===selected.id||r.endTableId===selected.id).length:relationships.length;
+  return <div className="review-toolbar" aria-label="ER 图工具栏">
+    <div className="review-toolbar-actions">
+      <button className="review-primary" onClick={arrange} disabled={layout.readOnly||!tables.length||groupScope.filtered} title={groupScope.filtered?"请返回全局后整理，避免改变子领域之外的布局":"按关系重新排布表格，可撤销；不会创建或删除关系"}>一键整理 ER 图</button>
+      <select aria-label="整理方向" value={settings.layoutDirection||'AUTO'} onChange={e=>setSettings(s=>({...s,layoutDirection:e.target.value}))}>
+        <option value="AUTO">自动方向</option><option value="LR">从左到右</option><option value="TB">从上到下</option>
+      </select>
+      <button onClick={()=>fit()} title="只调整视角">适应窗口</button>
+      <button onClick={()=>fit([selected],false)} disabled={!selected} title="放大到当前选中的表，只调整视角">定位选中</button>
+      <button onClick={undo} disabled={!canUndo||layout.readOnly}>撤销</button>
+      <span className="review-separator" />
+      <button aria-pressed={settings.focusRelations!==false} onClick={()=>setSettings(s=>({...s,focusRelations:s.focusRelations===false}))} title="点击表或连线锁定关系；悬停字段临时追踪并高亮两端">关系聚焦</button>
+      <select aria-label="连线方式" value={edgeStyle(settings)} onChange={e=>setSettings(s=>({...s,edgeStyle:e.target.value}))}>
+        <option value="smooth">柔和折线</option><option value="bezier">贝塞尔曲线</option><option value="straight">硬折线</option>
+      </select>
+      <button disabled={edgeStyle(settings)==="bezier"} aria-pressed={settings.edgeCrossingGaps!==false&&edgeStyle(settings)!=="bezier"} onClick={()=>setSettings(s=>({...s,edgeCrossingGaps:s.edgeCrossingGaps===false}))} title="在真实交叉处给下层线留白，正在追踪的线保持完整">交叉留白</button>
+      <button aria-pressed={settings.keyFieldsOnly} onClick={()=>setSettings(s=>({...s,keyFieldsOnly:!s.keyFieldsOnly}))} title="概览只显示主键与关联字段，全部字段可在左侧审阅">关系概览</button>
+      <button onClick={()=>setLayout(s=>({...s,sidebar:!s.sidebar}))}>{layout.sidebar?'收起目录':'展开目录'}</button>
+      <button onClick={save} disabled={layout.readOnly}>保存模型</button>
+    </div>
+    <GroupControls fit={fit} />
+    <div className="review-toolbar-context">
+      <span title={edgeText||undefined}>{groupScope.filtered&&!selected&&!selectedEdge&&!hoveredField?"全局总计：":""}{hoveredField?`${hoveredTable.name}.${hoveredField.name} · ${focus.activeIds.size} 条逻辑关联`:selected?`${selected.name} · ${count} 条关联`:selectedEdge?edgeText:`${tables.length} 张表 · ${count} 条逻辑关联${settings.keyFieldsOnly?' · 概览显示关键字段':''}`}</span>
+      {(selected||selectedEdge)&&<button onClick={()=>setSelectedElement(s=>({...s,id:-1,element:ObjectType.NONE,open:false}))}>取消聚焦</button>}
+      <small>拖动空白处平移 · Shift 拖动框选 · 视角自动记忆</small>
+    </div>
+  </div>;
+}
