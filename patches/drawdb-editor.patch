+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  margin-bottom: 7px;
+}
+.field-enum-heading strong {
+  font-size: 13px;
+}
+.field-enum-heading small {
+  color: #64748b;
+  font-weight: 400;
+}
+.field-enum-heading > span {
+  font-size: 10px;
+  color: #64748b;
+  text-align: right;
+}
+.field-enum-list {
+  max-height: 190px;
+  overflow: auto;
+  border: 1px solid #dbe3ec;
