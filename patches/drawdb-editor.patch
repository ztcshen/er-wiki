diff --git a/src/hooks/useGroupView.js b/src/hooks/useGroupView.js
new file mode 100644
index 0000000..a0d7cca
--- /dev/null
+++ b/src/hooks/useGroupView.js
@@ -0,0 +1,11 @@
+import { useMemo } from 'react';
+import { useDiagram } from './index';
+import { modelGroups, groupScope } from '../utils/tableGroups';
+
+export default function useGroupView() {
+  const { tables, relationships, reviewGroups, groupView } = useDiagram();
+  return useMemo(() => {
+    const groups = modelGroups(reviewGroups, tables);
+    return { groups, ...groupScope(tables, relationships, groups, groupView.id) };
+  }, [tables, relationships, reviewGroups, groupView.id]);
+}
diff --git a/src/hooks/useRelationshipFocus.js b/src/hooks/useRelationshipFocus.js
new file mode 100644
index 0000000..99a2526
--- /dev/null
+++ b/src/hooks/useRelationshipFocus.js
@@ -0,0 +1,35 @@
+import { useMemo } from 'react';
+import { useDiagram, useSelect, useSettings } from './index';
+import { ObjectType } from '../data/constants';
+import { getRelationshipFields } from '../utils/utils';
+import useGroupView from './useGroupView';
+
+export default function useRelationshipFocus() {
+  const { relationships, tables } = useDiagram();
+  const scope = useGroupView();
+  const { selectedElement, relationshipHover } = useSelect();
+  const { settings } = useSettings();
+  return useMemo(() => {
+    const enabled = settings.focusRelations !== false;
+    const hover = relationshipHover && (relationshipHover.relationshipId !== undefined || enabled)
+      ? relationshipHover : null;
+    let matches = [];
+    if (hover?.relationshipId !== undefined) matches = relationships.filter(r => r.id === hover.relationshipId);
+    else if (hover) matches = relationships.filter(r => getRelationshipFields(r).some(pair =>
+      (r.startTableId === hover.tableId && pair.startFieldId === hover.fieldId) ||
+      (r.endTableId === hover.tableId && pair.endFieldId === hover.fieldId)));
+    else if (enabled && selectedElement.element === ObjectType.TABLE) matches = relationships.filter(r =>
+      r.startTableId === selectedElement.id || r.endTableId === selectedElement.id);
+    else if (enabled && selectedElement.element === ObjectType.RELATIONSHIP) matches = relationships.filter(r => r.id === selectedElement.id);
+    const visible = matches.filter(r => scope.ids.has(r.startTableId) && scope.ids.has(r.endTableId) && !tables.find(t => t.id === r.startTableId)?.hidden &&
+      !tables.find(t => t.id === r.endTableId)?.hidden);
+    const fields = new Map();
+    for (const r of visible) for (const pair of getRelationshipFields(r)) {
+      for (const [tableId, fieldId] of [[r.startTableId, pair.startFieldId], [r.endTableId, pair.endFieldId]]) {
+        if (!fields.has(tableId)) fields.set(tableId, new Set());
+        fields.get(tableId).add(fieldId);
+      }
+    }
+    return { activeIds: new Set(visible.map(r => r.id)), fields, engaged: visible.length > 0, hover };
+  }, [relationships, tables, scope, selectedElement, relationshipHover, settings.focusRelations]);
+}
