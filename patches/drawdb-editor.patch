--- /dev/null
+++ b/src/utils/relationshipGeometry.js
@@ -0,0 +1,36 @@
+import { getVisibleFields, getVisibleFieldIndex, getRelationshipFields } from './utils';
+import { calcPath, calcCompositePath } from './calcPath';
+import { routeRelationshipPoints } from './routeRelationship';
+import { roundedPolyline, bezierPath, edgeStyle, hardenPath, fallbackVertices } from './edgePresentation';
+
+export function relationshipGeometry(data, tables, relationships, settings) {
+  const start = tables.find(t => t.id === data.startTableId);
+  const end = tables.find(t => t.id === data.endTableId);
+  if (!start || !end || start.hidden || end.hidden) return null;
+  const pairs = getRelationshipFields(data);
+  const index = (table, id) => getVisibleFieldIndex(table, id, relationships, settings.keyFieldsOnly);
+  const visible = table => ({ ...table, fields: getVisibleFields(table, relationships, settings.keyFieldsOnly) });
+  const pathValues = {
+    startTable: visible(start), endTable: visible(end),
+    startFieldIndex: index(start, data.startFieldId), endFieldIndex: index(end, data.endFieldId),
+    startFieldIndices: pairs.map(p => index(start, p.startFieldId)),
+    endFieldIndices: pairs.map(p => index(end, p.endFieldId)),
+  };
+  const composite = pairs.length > 1
+    ? calcCompositePath(pathValues, settings.tableWidth, 1, settings.showComments) : null;
+  const points = composite ? null : routeRelationshipPoints(pathValues, tables, relationships, data, settings);
+  const style = edgeStyle(settings);
+  if (style === 'bezier') {
+    const curves = pairs.map((_, index) => {
+      const single = { ...pathValues, startFieldIndex: pathValues.startFieldIndices[index], endFieldIndex: pathValues.endFieldIndices[index] };
+      const route = points || routeRelationshipPoints(single, tables, relationships, data, settings);
+      if (route) return bezierPath(route);
+      return bezierPath(fallbackVertices(calcPath(single, settings.tableWidth, 1, settings.showComments)));
+    });
+    return { id: data.id, pathValues, composite, points: null, path: curves.join(' ') };
+  }
+  return { id: data.id, pathValues, composite, points,
+    path: (composite && (style === 'straight' ? hardenPath(composite.path) : composite.path)) || (points && roundedPolyline(points, style === 'straight' ? 0 : undefined)) ||
+      (style === 'straight' ? roundedPolyline(fallbackVertices(calcPath(pathValues, settings.tableWidth, 1, settings.showComments)), 0)
+        : calcPath(pathValues, settings.tableWidth, 1, settings.showComments)) };
+}
diff --git a/src/utils/routeRelationship.js b/src/utils/routeRelationship.js
new file mode 100644
index 0000000..7c7002e
--- /dev/null
+++ b/src/utils/routeRelationship.js
@@ -0,0 +1,64 @@
+import { getTableHeight, getFieldOffsetY, getFieldRowHeight } from './utils';
+import { tableHeaderHeight, tableColorStripHeight, tableColumnsHeaderHeight } from '../data/constants';
+import { roundedPolyline } from './edgePresentation';
+
+// Rectilinear visibility grid: route between field ports without entering tables.
+export function routeRelationshipPoints(r, tables, relationships, relationship, settings) {
+  if (!r) return null;
+  const width = settings.tableWidth;
+  const lane = 18 + (Math.max(0, relationships.findIndex(e => e.id === relationship.id)) % 7) * 4;
+  const anchorY = (t, index) => t.y + tableHeaderHeight + tableColorStripHeight + tableColumnsHeaderHeight +
+    getFieldOffsetY(t.fields, index, width, settings.showComments) + getFieldRowHeight(settings.showComments) / 2;
+  const sameColumn = Math.abs(r.startTable.x - r.endTable.x) < width;
+  const startRight = sameColumn || r.endTable.x > r.startTable.x;
+  const endRight = sameColumn || !startRight;
+  const a = {x: r.startTable.x + (startRight ? width : 0), y: anchorY(r.startTable, r.startFieldIndex)};
+  const b = {x: r.endTable.x + (endRight ? width : 0), y: anchorY(r.endTable, r.endFieldIndex)};
+  const start = {x: a.x + (startRight ? lane + 12 : -lane - 12), y: a.y};
+  const goal = {x: b.x + (endRight ? lane + 12 : -lane - 12), y: b.y};
+  const obstacles = tables.filter(t => !t.hidden).map(t => ({
+    l: t.x - 8, r: t.x + width + 8, t: t.y - 8,
+    b: t.y + getTableHeight(t, width, settings.showComments, relationships, settings.keyFieldsOnly) + 8,
+  }));
+  const inside = p => obstacles.some(o => p.x > o.l && p.x < o.r && p.y > o.t && p.y < o.b);
+  const clear = (p, q) => !obstacles.some(o => p.y === q.y
+    ? p.y > o.t && p.y < o.b && Math.max(p.x,q.x) > o.l && Math.min(p.x,q.x) < o.r
+    : p.x > o.l && p.x < o.r && Math.max(p.y,q.y) > o.t && Math.min(p.y,q.y) < o.b);
+  const xs = [...new Set([start.x,goal.x,...obstacles.flatMap(o => [o.l-lane,o.r+lane])])].sort((x,y)=>x-y);
+  const ys = [...new Set([start.y,goal.y,...obstacles.flatMap(o => [o.t-lane,o.b+lane])])].sort((x,y)=>x-y);
+  const nx=xs.length, ny=ys.length;
+  const point = node => ({x:xs[node%nx],y:ys[Math.floor(node/nx)]});
+  const source = ys.indexOf(start.y)*nx+xs.indexOf(start.x);
+  const target = ys.indexOf(goal.y)*nx+xs.indexOf(goal.x);
+  if (inside(start) || inside(goal)) return null;
+  const h = node => {const p=point(node);return Math.abs(p.x-goal.x)+Math.abs(p.y-goal.y)};
+  const queue=[{node:source,dir:0,g:0,f:h(source)}], costs=new Map([[source*3,0]]), parent=new Map();
+  let finalKey=null;
+  while(queue.length){
+    let best=0;for(let i=1;i<queue.length;i++)if(queue[i].f<queue[best].f)best=i;
+    const current=queue.splice(best,1)[0], key=current.node*3+current.dir;
+    if(current.g!==costs.get(key))continue;
+    if(current.node===target){finalKey=key;break;}
+    const x=current.node%nx, y=Math.floor(current.node/nx);
+    for(const [xx,yy,dir] of [[x-1,y,1],[x+1,y,1],[x,y-1,2],[x,y+1,2]]){
+      if(xx<0||xx>=nx||yy<0||yy>=ny)continue;
+      const next=yy*nx+xx,p=point(current.node),q=point(next);
+      if(inside(q)||!clear(p,q))continue;
+      const g=current.g+Math.abs(p.x-q.x)+Math.abs(p.y-q.y)+(current.dir&&current.dir!==dir?20:0);
+      const nextKey=next*3+dir;
+      if(g >= (costs.get(nextKey)??Infinity))continue;
+      costs.set(nextKey,g);parent.set(nextKey,key);queue.push({node:next,dir,g,f:g+h(next)});
+    }
+  }
+  if(finalKey===null)return null;
+  const points=[];for(let k=finalKey;k!==undefined;k=parent.get(k))points.push(point(Math.floor(k/3)));
+  points.reverse();points.unshift(a);points.push(b);
+  const simplified=points.filter((p,i)=>i===0||i===points.length-1||
+    !((points[i-1].x===p.x&&p.x===points[i+1].x)||(points[i-1].y===p.y&&p.y===points[i+1].y)));
+  return simplified;
+}
+
+export function routeRelationship(r, tables, relationships, relationship, settings) {
+  const points = routeRelationshipPoints(r, tables, relationships, relationship, settings);
+  return points && roundedPolyline(points, settings.softEdges === false ? 0 : undefined);
+}
diff --git a/src/utils/tableGroups.js b/src/utils/tableGroups.js
new file mode 100644
index 0000000..3358ff0
--- /dev/null
+++ b/src/utils/tableGroups.js
@@ -0,0 +1,56 @@
+export const UNGROUPED = '__ungrouped__';
+const colorPattern = /^#[0-9a-f]{6}$/i;
+
+export function modelGroups(value, tables = []) {
+  if (value === undefined) {
+    // Grouping belongs to the imported model.
+    // Do not infer a business domain from familiar table names.
+    // The public demo includes its own explicit groups.
+    return [];
+  }
+  if (!Array.isArray(value)) return [];
+  const ids = new Set(), assigned = new Set(), known = new Set(tables.map(t => t.id));
+  return value.filter(g => g && typeof g.id === 'string' && g.id && g.id !== UNGROUPED &&
+    typeof g.name === 'string' && g.name.trim() && colorPattern.test(g.color) && Array.isArray(g.tableIds))
+    .filter(g => { if (ids.has(g.id)) return false; ids.add(g.id); return true; })
+    .map(g => ({ id: g.id, name: g.name.trim(), color: g.color, tableIds: g.tableIds.filter(id => {
+      if (!known.has(id) || assigned.has(id)) return false;
+      assigned.add(id); return true;
+    }) }));
+}
+
+export function validateGroups(groups, tables) {
+  if (groups === undefined) return;
+  if (!Array.isArray(groups) || groups.length > 200) throw new Error('分组数据格式不正确');
+  const normalized = modelGroups(groups, tables);
+  if (normalized.length !== groups.length || groups.some((group, index) =>
+    group.name.length > 80 || group.id.length > 128 || normalized[index].tableIds.length !== group.tableIds.length)) {
+    throw new Error('分组名称、颜色或成员无效；一张表只能属于一个分组');
+  }
+}
+
+export function groupScope(tables, relationships, groups, selectedId = '') {
+  const membership = new Map(groups.flatMap(group => group.tableIds.map(id => [id, group])));
+  const group = groups.find(g => g.id === selectedId);
+  const filtered = Boolean(group || selectedId === UNGROUPED);
+  const memberTables = tables.filter(t => !filtered ||
+    (group ? membership.get(t.id)?.id === group.id : !membership.has(t.id)));
+  const visibleTables = memberTables.filter(t => !t.hidden);
+  const memberIds = new Set(memberTables.map(t => t.id));
+  const ids = new Set(visibleTables.map(t => t.id));
+  const visibleRelationships = relationships.filter(r => ids.has(r.startTableId) && ids.has(r.endTableId));
+  const externalCount = filtered ? relationships.filter(r => ids.has(r.startTableId) !== ids.has(r.endTableId)).length : 0;
+  const memberRelationships = relationships.filter(r => memberIds.has(r.startTableId) && memberIds.has(r.endTableId));
+  return { group, filtered, membership, memberTables, memberRelationships, tables: visibleTables, relationships: visibleRelationships, ids, externalCount };
+}
+
+export function groupEdgeColor(relationship, membership) {
+  const start = membership.get(relationship.startTableId), end = membership.get(relationship.endTableId);
+  return start && end && start.id === end.id ? start.color : null;
+}
+
+export function mergeVisibleOrder(all, reordered) {
+  const ids = new Set(reordered.map(item => item.id));
+  let index = 0;
+  return all.map(item => ids.has(item.id) ? reordered[index++] : item);
+}
