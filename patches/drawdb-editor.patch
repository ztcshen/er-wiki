--- /dev/null
+++ b/src/utils/fieldEnumValues.js
@@ -0,0 +1,30 @@
+import catalogue from "../data/field-enums.json";
+
+export const isSqlEnum = (field) =>
+  ["ENUM", "SET"].includes(String(field.type).toUpperCase());
+
+export function fieldEnumValues(tableName, field) {
+  if (isSqlEnum(field)) {
+    const labels = new Map(
+      (field.reviewEnumValues ?? []).map((v) => [v.value, v.label]),
+    );
+    return {
+      values: (field.values ?? []).map((value) => ({
+        value: String(value),
+        label: labels.get(String(value)) || "",
+      })),
+      source: "SQL ENUM / SET",
+      native: true,
+    };
+  }
+  // [] is an intentional clear, not a request to reload the catalogue.
+  if (Array.isArray(field.reviewEnumValues))
+    return { values: field.reviewEnumValues, source: "自定义审阅枚举" };
+  const definition = catalogue.fields[tableName]?.[field.name];
+  if (!definition) return { values: [], source: "未定义" };
+  return {
+    values: catalogue.sets[definition.set] || [],
+    source: definition.source,
+    partial: definition.partial,
+  };
+}
