diff --git a/src/components/EditorHeader/GroupControls.jsx b/src/components/EditorHeader/GroupControls.jsx
new file mode 100644
index 0000000..b040144
--- /dev/null
+++ b/src/components/EditorHeader/GroupControls.jsx
@@ -0,0 +1,80 @@
+import { useEffect, useRef, useState } from 'react';
+import { Modal, Button } from '@douyinfe/semi-ui';
+import { useParams } from 'react-router-dom';
+import { useDiagram, useTransform, useSelect, useLayout } from '../../hooks';
+import { ObjectType, Tab } from '../../data/constants';
+import useGroupView from '../../hooks/useGroupView';
+import { UNGROUPED, validateGroups } from '../../utils/tableGroups';
+import './group-controls.css';
+
+export default function GroupControls({ fit }) {
+  const { tables, updateReviewGroups, groupView, setGroupView } = useDiagram();
+  const scope = useGroupView();
+  const { transform, setTransform } = useTransform();
+  const { setSelectedElement, setBulkSelectedElements, setRelationshipHover } = useSelect();
+  const { layout } = useLayout();
+  const { id } = useParams();
+  const views = useRef(new Map());
+  const [open, setOpen] = useState(false), [draft, setDraft] = useState([]), [selected, setSelected] = useState('');
+  const [error, setError] = useState('');
+  const editing = draft.find(g => g.id === selected);
+  useEffect(() => { views.current.clear(); setOpen(false); }, [id]);
+  useEffect(() => {
+    if (groupView.id && !scope.filtered) {
+      if (groupView.globalTransform) setTransform(groupView.globalTransform);
+      setGroupView({ id: '', globalTransform: null });
+    }
+  }, [groupView, scope.filtered, setGroupView, setTransform]);
+  const switchView = next => {
+    views.current.set(groupView.id, structuredClone(transform));
+    const globalTransform = groupView.id ? groupView.globalTransform : structuredClone(transform);
+    setGroupView({ id: next, globalTransform: next ? globalTransform : null });
+    setSelectedElement(s => ({ ...s, element: ObjectType.NONE, id: -1, open: false, openDialogue: false, currentTab: Tab.TABLES }));
+    setBulkSelectedElements([]); setRelationshipHover(null);
+    const remembered = next ? views.current.get(next) : globalTransform;
+    if (remembered) setTransform(remembered);
+    else {
+      const group = scope.groups.find(g => g.id === next);
+      fit(tables.filter(t => next === UNGROUPED ? !scope.membership.has(t.id) : group?.tableIds.includes(t.id)), false);
+    }
+  };
+  const edit = () => { setDraft(structuredClone(scope.groups)); setSelected(scope.groups[0]?.id || ''); setError(''); setOpen(true); };
+  const change = values => setDraft(current => current.map(g => g.id === selected ? { ...g, ...values } : g));
+  const assign = (tableId, checked) => setDraft(current => current.map(g => ({ ...g,
+    tableIds: checked && g.id === selected ? [...new Set([...g.tableIds, tableId])] : g.tableIds.filter(id => id !== tableId),
+  })));
+  return <>
+    <div className="group-view-bar" aria-label="分组视图">
+      <label>分组视图 <select aria-label="查看分组" value={scope.filtered ? groupView.id : ''} onChange={e => switchView(e.target.value)}>
+        <option value="">全部分组 · {tables.length} 张表</option>
+        {scope.groups.map(g => <option key={g.id} value={g.id}>{g.name} · {g.tableIds.length} 张表</option>)}
+        <option value={UNGROUPED}>未分组 · {tables.filter(t => !scope.membership.has(t.id)).length} 张表</option>
+      </select></label>
+      <button onClick={edit}>管理分组</button>
+      {scope.filtered && <button onClick={() => switchView('')}>返回全局</button>}
+      <span className="group-view-summary">{scope.filtered ? `${scope.tables.length} 张表 · ${scope.relationships.length} 条组内关系 · ${scope.externalCount} 条外部引用（全局可见）` : '全局视角 · 组内连线同色，跨组连线为灰蓝色'}</span>
+      <div className="group-legend">{scope.groups.map(g => <span key={g.id} title={g.name}><i style={{background:g.color}} />{g.name}</span>)}</div>
+    </div>
+    <Modal title="表分组" visible={open} centered width={800} footer={null} onCancel={() => setOpen(false)} closeOnEsc maskClosable={false}>
+      <p className="group-editor-hint">一张表只属于一个分组。修改分组会随模型保存；切换查看范围只改变视图。选择其他组中的表会将其移入当前组。</p>
+      <div className="group-editor">
+        <div className="group-list">
+          {draft.map(g => <button key={g.id} aria-pressed={g.id === selected} onClick={() => setSelected(g.id)}><i style={{background:g.color}} />{g.name || '未命名分组'} <small>{g.tableIds.length}</small></button>)}
+          <button disabled={layout.readOnly} onClick={() => { const groupId=crypto.randomUUID(); setDraft(current=>[...current,{id:groupId,name:'新分组',color:'#3276b9',tableIds:[]}]);setSelected(groupId); }}>新建分组</button>
+        </div>
+        <div className="group-details">
+          {editing ? <>
+            <div className="group-editor-fields"><label>名称<input aria-label="分组名称" value={editing.name} maxLength={80} disabled={layout.readOnly} onChange={e=>change({name:e.target.value})} /></label>
+              <label>颜色<input aria-label="分组颜色" type="color" value={editing.color} disabled={layout.readOnly} onChange={e=>change({color:e.target.value})} /></label></div>
+            <div className="group-table-list">{tables.map(table=>{const owner=draft.find(g=>g.tableIds.includes(table.id));return <label key={table.id}>
+              <input type="checkbox" aria-label={`分组成员 ${table.name}`} checked={editing.tableIds.includes(table.id)} disabled={layout.readOnly} onChange={e=>assign(table.id,e.target.checked)} />
+              <span title={table.name}>{table.name}</span><small>{owner?.name || '未分组'}</small></label>;})}</div>
+            <Button type="danger" disabled={layout.readOnly} onClick={()=>{setDraft(current=>current.filter(g=>g.id!==selected));setSelected(draft.find(g=>g.id!==selected)?.id||'');}}>删除分组</Button>
+          </> : <p>尚无分组，点击“新建分组”。删除分组不会删除其中的表或关系。</p>}
+        </div>
+      </div>
+      {error && <p role="alert" className="group-editor-error">{error}</p>}
+      <div className="group-editor-footer"><Button onClick={()=>setOpen(false)}>取消</Button><Button theme="solid" disabled={layout.readOnly} onClick={()=>{try{validateGroups(draft,tables);updateReviewGroups(draft);setOpen(false);}catch(e){setError(e.message);}}}>应用分组</Button></div>
+    </Modal>
+  </>;
+}
