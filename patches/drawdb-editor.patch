diff --git a/src/components/EditorCanvas/CanvasEditorDialog.jsx b/src/components/EditorCanvas/CanvasEditorDialog.jsx
new file mode 100644
index 0000000..617d812
--- /dev/null
+++ b/src/components/EditorCanvas/CanvasEditorDialog.jsx
@@ -0,0 +1,61 @@
+import { Button, Modal } from "@douyinfe/semi-ui";
+import { useLayout, useSettings } from "../../hooks";
+import "./canvas-editor-dialog.css";
+
+export default function CanvasEditorDialog({
+  title,
+  visible,
+  onClose,
+  children,
+  accentColor = "#0f766e",
+}) {
+  const { settings } = useSettings();
+  const { layout } = useLayout();
+  if (!visible) return null;
+
+  const close = () => {
+    // Field undo records are committed on blur, including when closing with Esc.
+    const active = document.activeElement;
+    if (
+      active instanceof HTMLElement &&
+      active.closest(".canvas-editor-dialog")
+    ) {
+      active.blur();
+    }
+    onClose();
+  };
+
+  return (
+    <Modal
+      className="canvas-editor-dialog"
+      title={title}
+      visible
+      centered
+      width={740}
+      style={{
+        maxWidth: "calc(100vw - 24px)",
+        margin: "12px auto",
+        "--editor-accent": accentColor,
+      }}
+      onCancel={close}
+      maskClosable={false}
+      closeOnEsc
+      footer={
+        <div className="canvas-editor-footer">
+          <span>
+            {layout.readOnly
+              ? "只读浏览"
+              : settings.autosave
+                ? "修改自动保存到当前浏览器，可撤销。"
+                : "自动保存已关闭；关闭后请点“保存模型”。"}
+          </span>
+          <Button onClick={close} aria-label="关闭编辑器">
+            关闭
+          </Button>
+        </div>
+      }
+    >
+      <div className="sidesheet-theme">{children}</div>
+    </Modal>
+  );
+}
diff --git a/src/components/EditorCanvas/FieldEnumEditor.jsx b/src/components/EditorCanvas/FieldEnumEditor.jsx
new file mode 100644
index 0000000..6bfb6d9
--- /dev/null
+++ b/src/components/EditorCanvas/FieldEnumEditor.jsx
@@ -0,0 +1,175 @@
+import { useState } from "react";
+import { useDiagram, useLayout, useUndoRedo } from "../../hooks";
+import { Action, ObjectType } from "../../data/constants";
+import { fieldEnumValues, isSqlEnum } from "../../utils/fieldEnumValues";
+import "./field-enum-editor.css";
+
+export default function FieldEnumEditor({ tableId, tableName, field }) {
+  const { updateField } = useDiagram();
+  const { layout } = useLayout();
+  const { setUndoStack, setRedoStack } = useUndoRedo();
+  const [value, setValue] = useState("");
+  const [label, setLabel] = useState("");
+  const [error, setError] = useState("");
+  const definition = fieldEnumValues(tableName, field);
+  const values = definition.values;
+
+  const commit = (next) => {
+    if (layout.readOnly) return;
+    const undo = { reviewEnumValues: field.reviewEnumValues };
+    const redo = { reviewEnumValues: next };
+    if (isSqlEnum(field)) {
+      undo.values = field.values;
+      redo.values = next.map((v) => v.value);
+    }
+    setUndoStack((stack) => [
+      ...stack,
+      {
+        action: Action.EDIT,
+        element: ObjectType.TABLE,
+        component: "field",
+        tid: tableId,
+        fid: field.id,
+        undo,
+        redo,
+        message: `修改枚举 ${tableName}.${field.name}`,
+      },
+    ]);
+    setRedoStack([]);
+    updateField(tableId, field.id, redo);
+    setError("");
+  };
+  const add = () => {
+    if (layout.readOnly) return;
+    const code = value.trim();
+    if (!code) {
+      setError("请输入枚举值");
+      return;
+    }
+    if (values.some((v) => v.value === code)) {
+      setError("该枚举值已存在");
+      return;
+    }
+    commit([...values, { value: code, label: label.trim() }]);
+    setValue("");
+    setLabel("");
+  };
+  const defaultValue = field.default == null ? "" : String(field.default);
+  const outsideDefault =
+    defaultValue !== "" &&
+    defaultValue !== "NULL" &&
+    values.length > 0 &&
+    !values.some((v) => v.value === defaultValue);
+
+  return (
+    <section
+      className="field-enum-editor"
+      aria-label={`枚举值 ${tableName}.${field.name}`}
+      data-enum-editor={`${tableName}.${field.name}`}
+    >
+      <div className="field-enum-heading">
+        <strong>
+          枚举值 <small>{values.length}</small>
+        </strong>
+        <span>{definition.source}</span>
+      </div>
+      {values.length ? (
+        <div className="field-enum-list">
+          <table>
+            <thead>
+              <tr>
+                <th>值</th>
+                <th>中文含义</th>
+                <th aria-label="枚举操作" />
+              </tr>
+            </thead>
+            <tbody>
+              {values.map((item) => (
+                <tr key={item.value} data-enum-value={item.value}>
+                  <td>
+                    <code>{item.value}</code>
+                    {defaultValue === item.value && (
+                      <small className="field-enum-default">默认</small>
+                    )}
+                  </td>
+                  <td>{item.label || "—"}</td>
+                  <td>
+                    {!layout.readOnly && (
+                      <button
+                        type="button"
+                        aria-label={`移除枚举 ${item.value}`}
+                        onClick={() =>
+                          commit(values.filter((v) => v.value !== item.value))
+                        }
+                      >
+                        移除
+                      </button>
+                    )}
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+      ) : (
+        <p className="field-enum-empty">
+          {definition.source === "未定义"
+            ? "尚未定义枚举值，可添加。"
+            : "当前枚举列表为空，可添加。"}
+        </p>
+      )}
+      {definition.partial && (
+        <p className="field-enum-hint">原说明带“等”，这里只列出已知取值。</p>
+      )}
+      {outsideDefault && (
+        <p className="field-enum-warning">
+          默认值 {defaultValue} 未列在当前枚举中。
+        </p>
+      )}
+      {!layout.readOnly && (
+        <form
+          className="field-enum-add"
+          onSubmit={(e) => {
+            e.preventDefault();
+            e.stopPropagation();
+            add();
+          }}
+        >
+          <input
+            aria-label="枚举值"
+            placeholder="值，如 PENDING"
+            value={value}
+            maxLength={128}
+            onChange={(e) => {
+              setValue(e.target.value);
+              setError("");
+            }}
+          />
+          <input
+            aria-label="枚举中文含义"
+            placeholder="中文含义（可选）"
+            value={label}
+            maxLength={80}
+            onChange={(e) => setLabel(e.target.value)}
+          />
+          <button type="submit">添加</button>
+        </form>
+      )}
+      {error && (
+        <p className="field-enum-error" role="alert">
+          {error}
+        </p>
+      )}
+      {!definition.native && (
+        <p className="field-enum-hint">
+          修改随当前图表保存，可撤销；不自动改字段类型或 DDL。
+        </p>
+      )}
+      {field.check && (
+        <p className="field-enum-hint">
+          原 CHECK：<code>{field.check}</code>
+        </p>
+      )}
+    </section>
