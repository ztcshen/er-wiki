new file mode 100644
index 0000000..9a500c9
--- /dev/null
+++ b/src/components/EditorCanvas/RelationshipLayer.jsx
@@ -0,0 +1,28 @@
+import { useMemo } from 'react';
+import { useDiagram, useSettings, useTransform } from '../../hooks';
+import useRelationshipFocus from '../../hooks/useRelationshipFocus';
+import { relationshipGeometry } from '../../utils/relationshipGeometry';
+import { edgeCrossings, crossingGaps } from '../../utils/edgePresentation';
+import Relationship from './Relationship';
+import useGroupView from '../../hooks/useGroupView';
+
+export default function RelationshipLayer() {
+  const { relationships } = useDiagram();
+  const scope = useGroupView();
+  const { settings } = useSettings();
+  const { transform } = useTransform();
+  const focus = useRelationshipFocus();
+  // Route each edge once per geometry change, not again for hover or zoom.
+  const geometries = useMemo(() => scope.relationships.map(data =>
+    relationshipGeometry(data, scope.tables, relationships, {
+      tableWidth: settings.tableWidth, showComments: settings.showComments,
+      keyFieldsOnly: settings.keyFieldsOnly, edgeStyle: settings.edgeStyle,
+    })), [scope, relationships, settings.tableWidth, settings.showComments, settings.keyFieldsOnly, settings.edgeStyle]);
+  const crossings = useMemo(() => edgeCrossings(geometries.filter(Boolean)), [geometries]);
+  const gaps = useMemo(() => settings.edgeCrossingGaps === false ? new Map() :
+    crossingGaps(crossings, focus.activeIds, transform.zoom), [crossings, focus.activeIds, transform.zoom, settings.edgeCrossingGaps]);
+  return <g data-relationship-layer>
+    {scope.relationships.map((data, index) => <Relationship key={data.id} data={data}
+      geometry={geometries[index]} focus={focus} gaps={gaps.get(data.id) || []} />)}
+  </g>;
+}
