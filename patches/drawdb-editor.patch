diff --git a/src/utils/edgePresentation.js b/src/utils/edgePresentation.js
new file mode 100644
index 0000000..b4e73ab
--- /dev/null
+++ b/src/utils/edgePresentation.js
@@ -0,0 +1,87 @@
+// SVG presentation only: none of these calculations alter the diagram model.
+export const edgeCornerRadius = 18;
+
+export function edgeStyle(settings) {
+  return ['smooth', 'bezier', 'straight'].includes(settings.edgeStyle) ? settings.edgeStyle : 'smooth';
+}
+
+export function bezierPath(points) {
+  if (!points?.length) return '';
+  const a = points[0], b = points.at(-1);
+  const out = Math.sign((points[1]?.x ?? a.x + 1) - a.x) || 1;
+  const into = Math.sign((points.at(-2)?.x ?? b.x - 1) - b.x) || -1;
+  const reach = Math.max(48, Math.min(220, Math.abs(b.x - a.x) * 0.45 + Math.abs(b.y - a.y) * 0.1));
+  return `M ${a.x} ${a.y} C ${a.x + out * reach} ${a.y} ${b.x + into * reach} ${b.y} ${b.x} ${b.y}`;
+}
+
+export function hardenPath(path) {
+  // calcCompositePath uses quadratic corners; preserve its exact fork topology.
+  return path.replace(/Q\s+([-\d.e+]+)[ ,]+([-\d.e+]+)[ ,]+([-\d.e+]+)[ ,]+([-\d.e+]+)/gi,
+    (_, x, y, endX, endY) => `L ${x} ${y} L ${endX} ${endY}`);
+}
+
+export function fallbackVertices(path) {
+  const points = [];
+  for (const match of path.matchAll(/([MLAQ])\s*([^MLAQ]+)/gi)) {
+    const numbers = match[2].match(/-?\d*\.?\d+(?:e[-+]?\d+)?/gi)?.map(Number) || [];
+    const end = { x: numbers.at(-2), y: numbers.at(-1) };
+    if (match[1].toUpperCase() === 'Q') points.push({ x: numbers[0], y: numbers[1] });
+    if (match[1].toUpperCase() === 'A' && points.length) {
+      const current = points.at(-1), previous = points.at(-2);
+      points.push(!previous || previous.y === current.y ? { x: end.x, y: current.y } : { x: current.x, y: end.y });
+    }
+    if (Number.isFinite(end.x) && Number.isFinite(end.y)) points.push(end);
+  }
+  return points;
+}
+
+export function roundedPolyline(points, radius = edgeCornerRadius) {
+  if (!points?.length) return '';
+  let path = `M ${points[0].x} ${points[0].y}`;
+  for (let i = 1; i < points.length - 1; i++) {
+    const a = points[i - 1], b = points[i], c = points[i + 1];
+    const before = Math.hypot(b.x - a.x, b.y - a.y);
+    const after = Math.hypot(c.x - b.x, c.y - b.y);
+    const r = Math.min(radius, before / 2, after / 2);
+    if (!r) { path += ` L ${b.x} ${b.y}`; continue; }
+    path += ` L ${b.x - (b.x - a.x) * r / before} ${b.y - (b.y - a.y) * r / before}`;
+    path += ` Q ${b.x} ${b.y} ${b.x + (c.x - b.x) * r / after} ${b.y + (c.y - b.y) * r / after}`;
+  }
+  if (points.length > 1) path += ` L ${points.at(-1).x} ${points.at(-1).y}`;
+  return path;
+}
+
+// Detect genuine transverse crossings only. Shared ports, parallel overlaps,
+// rounded bends and composite/fallback curves must not get arbitrary holes.
+export function edgeCrossings(routes) {
+  const crossings = [];
+  const segments = routes.flatMap(({ id, points }) => (points || []).slice(1).map((to, i) => ({
+    id, from: points[i], to, horizontal: points[i].y === to.y,
+  })));
+  for (let i = 0; i < segments.length; i++) {
+    const a = segments[i];
+    for (let j = 0; j < i; j++) {
+      const b = segments[j];
+      if (a.id === b.id || a.horizontal === b.horizontal) continue;
+      const h = a.horizontal ? a : b, v = a.horizontal ? b : a;
+      const x = v.from.x, y = h.from.y;
+      const clearance = Math.min(x - Math.min(h.from.x, h.to.x), Math.max(h.from.x, h.to.x) - x,
+        y - Math.min(v.from.y, v.to.y), Math.max(v.from.y, v.to.y) - y) - edgeCornerRadius;
+      if (clearance > 2) crossings.push({ x, y, horizontal: h.id, vertical: v.id, clearance });
+    }
+  }
+  return crossings;
+}
+
+export function crossingGaps(crossings, activeIds, zoom = 1) {
+  const gaps = new Map();
+  for (const crossing of crossings) {
+    // Keep a uniquely highlighted edge uninterrupted. Otherwise horizontal wins.
+    const under = activeIds.has(crossing.vertical) && !activeIds.has(crossing.horizontal)
+      ? crossing.horizontal : crossing.vertical;
+    const radius = Math.min(4 / Math.max(0.05, zoom), crossing.clearance / 2);
+    if (!gaps.has(under)) gaps.set(under, []);
+    gaps.get(under).push({ x: crossing.x, y: crossing.y, radius });
+  }
+  return gaps;
+}
diff --git a/src/utils/fieldEnumValues.js b/src/utils/fieldEnumValues.js
new file mode 100644
